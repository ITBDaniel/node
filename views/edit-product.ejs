<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar producte</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <h1>Editar producte</h1>
        <a href="/products">Tornar</a>
      </header>

      <main class="card">
        <form action="/products/<%= product._id %>?_method=PUT" method="POST">
          <label for="name">Nom</label>
          <input id="name" name="name" type="text" value="<%= product.name %>" required />

          <label for="category">Categoria</label>
          <input id="category" name="category" type="text" value="<%= product.category %>" required />

          <label for="price">Preu</label>
          <input id="price" name="price" type="number" min="0" step="0.01" value="<%= product.price %>" required />

          <label for="stock">Stock</label>
          <input id="stock" name="stock" type="number" min="0" value="<%= product.stock %>" required />

          <label for="description">Descripció</label>
          <textarea id="description" name="description" rows="4"><%= product.description %></textarea>

          <button type="submit">Guardar canvis</button>
        </form>
      </main>
    </div>
  </body>
</html>